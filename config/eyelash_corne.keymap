#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define QWERTY 0
#define NUMBER 1
#define SYMBOL 2
#define MOUSE  3

/ {
    behaviors {
        lt_esc: lt_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_ESC";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lt_tab: lt_tab {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TAB";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lt_del: lt_del {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_DEL";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lt_ent: lt_ent {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_ENT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lt_spc: lt_spc {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SPC";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lt_bspc: lt_bspc {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_BSPC";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
&lt_esc MOUSE ESC  &kp Q  &kp W  &kp E     &kp R      &kp T      &kp UP     &kp Y      &kp U      &kp I     &kp O   &kp P     &lt_del MOUSE DEL
&lt_tab SYMBOL TAB &kp A  &kp S  &kp D     &kp F      &kp G      &kp LEFT   &kp RET    &kp RIGHT  &kp H     &kp J   &kp K     &kp L   &kp SEMI  &lt_ent MOUSE RET
&kp LCTRL          &kp Z  &kp X  &kp C     &kp V      &kp B      &kp DOWN   &kp N      &kp M      &kp COMMA &kp DOT &kp FSLH  &kp RCTRL
                                 &kp LALT  &kp LSHFT  &lt_spc NUMBER SPACE   &none      &lt_bspc NUMBER BSPC &kp RSHFT &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        number_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp PLUS   &kp N7  &kp N8  &kp N9  &kp STAR     &trans     &kp K_APP     &kp PG_DN  &kp UP       &kp PG_UP    &kp PRINTSCREEN &trans
&trans  &kp MINUS  &kp N4  &kp N5  &kp N6  &kp PRCNT    &trans     &trans        &trans     &kp HOME     &kp LEFT     &kp DOWN     &kp RIGHT    &kp END         &trans
&trans  &kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL    &trans     &kp C_BRI_DN  &kp C_BRI_UP &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE      &trans
                           &trans  &trans  &trans       &trans     &trans        &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp GRAVE  &kp TILDE  &kp LPAR  &kp RPAR    &none  &trans     &kp EXCL   &kp PIPE  &kp BSLH  &none  &none  &trans
&trans  &kp SQT    &kp DOUBLE_QUOTES &kp LBRC &kp RBRC &none &trans &trans &trans &kp CARET &kp AT   &kp DLLR  &none  &none  &trans
&trans  &none      &kp UNDER  &kp LBKT  &kp RBKT    &none  &trans     &kp AMPS   &kp HASH  &none     &none  &none  &trans
                              &trans    &trans      &trans &trans     &trans     &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5     &mmv MOVE_UP    &mkp RCLK       &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP    &none  &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10    &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT &msc SCRL_RIGHT &trans
&trans  &kp F11  &kp F12  &none   &none   &none      &mmv MOVE_DOWN  &none           &mkp LCLK       &mkp MCLK       &mkp RCLK       &none  &trans
                          &trans  &trans  &trans     &trans          &trans          &trans          &trans
            >;
            sensor-bindings = <&inc_dec_msc SCRL_UP SCRL_DOWN>;
        };
    };
};
