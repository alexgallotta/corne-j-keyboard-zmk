#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
 
#define DEFAULT 0
#define NUM     1
#define SYM     2
#define MOUSE   3

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
       bindings = <
&lt MOUSE ESC   &kp Q  &kp W  &kp E     &kp R      &kp T                         &kp UP                     &kp Y        &kp U      &kp I      &kp O    &kp P     &lt MOUSE DEL
&lt SYM TAB     &kp A  &kp S  &kp D     &kp F      &kp G            &kp LEFT     &kp ENTER     &kp RIGHT    &kp H        &kp J      &kp K      &kp L    &kp SEMI  &lt SYM RET
&kp LCTRL       &kp Z  &kp X  &kp C     &kp V      &kp B    &none                &kp DOWN                   &kp N        &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RCTRL
                           &kp LALT  &kp LSHFT  &lt NUM SPACE                                &lt NUM BSPC &kp RSHFT  &kp RGUI
       >;
        };

        num_layer {
            bindings = <
&trans  &kp PLUS   &kp N7  &kp N8  &kp N9  &kp ASTRK                                 &rgb_ug RGB_BRI                   &kp K_APP     &kp PG_DN  &kp UP    &kp PG_UP  &kp PSCRN  &trans
&trans  &kp MINUS  &kp N4  &kp N5  &kp N6  &kp PRCNT                 &rgb_ug RGB_HUD &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &kp HOME      &kp LEFT   &kp DOWN  &kp RIGHT  &kp END    &trans
&trans  &kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL  &none                          &rgb_ug RGB_BRD                   &kp C_BRI_DN  &kp C_BRI_UP &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans
                           &trans  &trans  &trans                                                                      &trans        &trans     &trans
            >;
        };

        sym_layer {
            bindings = <
&trans  &none  &kp GRAVE  &kp TILDE  &kp LPAR  &kp RPAR                                 &trans                            &none  &kp EXCL  &kp PIPE  &kp BSLH  &none  &trans
&trans  &none  &kp SQT    &kp DQT    &kp LBRC  &kp RBRC                 &trans          &trans          &trans            &none  &kp CARET &kp AT    &kp DLLR  &none  &trans
&trans  &none  &none      &kp UNDER  &kp LBKT  &kp RBKT   &none                         &trans                            &none  &kp AMPS  &kp HASH  &none     &none  &trans
                          &trans     &trans    &trans                                                                     &trans &trans    &trans
            >;
        };

        mouse_layer {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                                         &trans                            &mkp RCLK       &msc SCRL_DOWN &mmv MOVE_UP   &msc SCRL_UP    &none  &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10               &bt BT_PRV               &trans           &bt BT_NXT       &msc SCRL_LEFT  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_RIGHT &trans
&trans  &kp F11  &kp F12  &none   &none   &none   &none                                  &trans                            &none           &mkp LCLK      &mkp MCLK      &mkp RCLK       &none  &trans
                          &trans  &trans  &trans                                                                           &trans          &trans         &trans
            >;
        };
    };
};
